import itertools

graph = {
    'A': {'B': 10, 'C': 15, 'D': 20},
    'B': {'A': 10, 'C': 35, 'D': 25},
    'C': {'A': 15, 'B': 35, 'D': 30},
    'D': {'A': 20, 'B': 25, 'C': 30}
}

vertices = list(graph.keys())
start = 'A'

def tour_cost(path):
    cost = 0
    for i in range(len(path) - 1):
        cost += graph[path[i]][path[i + 1]]
    cost += graph[path[-1]][start]
    return cost

other_vertices = [v for v in vertices if v != start]

min_cost = float('inf')
best_path = None

for permutation in itertools.permutations(other_vertices):
    path = [start] + list(permutation)
    cost = tour_cost(path)

    if cost < min_cost:
        min_cost = cost
        best_path = path

print("Minimum Cost:", min_cost)
print("Best Path:", best_path + [start])


OUTPUT:
Minimum Cost: 80
Best Path: ['A', 'B', 'D', 'C', 'A']
